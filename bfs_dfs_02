#Uninformed searched algorithms
from collections import deque
import time

# Tree
tree = {
    "A": ["B", "C"],
    "B": ["D", "E"],
    "C": ["F", "G"],
    "D": [], "E": [], "F": [], "G": []
}

START, GOAL = "A", "G"

# Find path
def get_path(parent, goal):
    path = []
    while goal is not None:
        path.append(goal)
        goal = parent[goal]
    return path[::-1]


# BFS
def bfs(tree, start, goal):
    t = time.perf_counter()
    q = deque([start])
    visited = {start}
    parent = {start: None}
    order = []

    while q:
        node = q.popleft()
        order.append(node)

        if node == goal:
            break

        for n in tree[node]:
            if n not in visited:
                visited.add(n)
                parent[n] = node
                q.append(n)

    return order, get_path(parent, goal), time.perf_counter()-t


# DFS
def dfs(tree, start, goal):
    t = time.perf_counter()
    stack = [start]
    visited = {start}
    parent = {start: None}
    order = []

    while stack:
        node = stack.pop()
        order.append(node)

        if node == goal:
            break

        for n in reversed(tree[node]):
            if n not in visited:
                visited.add(n)
                parent[n] = node
                stack.append(n)

    return order, get_path(parent, goal), time.perf_counter()-t


# Display tree
print("Tree Structure:")
print("      A")
print("     / \\")
print("    B   C")
print("   / \\ / \\")
print("  D  E F  G")

# Run algorithms
for name, result in [("BFS", bfs(tree, START, GOAL)),
                     ("DFS", dfs(tree, START, GOAL))]:

    order, path, t = result
    print("\n", name)
    print("Exploration Order:", " -> ".join(order))
    print("Solution Path:", " -> ".join(path))
    print("Path Length:", len(path)-1)
    print("Nodes Explored:", len(order))
    print("Execution Time:", round(t, 6), "seconds")
