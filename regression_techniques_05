#Linear and Polynomial Regression 

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import Pipeline
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

# 1. Load dataset
data = fetch_california_housing(as_frame=True)
df = data.frame

print("Dataset Shape:", df.shape)
print(df.head())

# 2. Separate input and output
X = df.drop("MedHouseVal", axis=1)
y = df["MedHouseVal"]

# 3. Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

print("Training Data:", X_train.shape)
print("Testing Data:", X_test.shape)

# 4. Linear Regression
linear_model = LinearRegression()
linear_model.fit(X_train, y_train)
linear_prediction = linear_model.predict(X_test)

# 5. Polynomial Regression
polynomial_model = Pipeline([
    ("polynomial", PolynomialFeatures(degree=2, include_bias=False)),
    ("scaler", StandardScaler()),
    ("regression", LinearRegression())
])

polynomial_model.fit(X_train, y_train)
polynomial_prediction = polynomial_model.predict(X_test)

# 6. Evaluate both models
results = pd.DataFrame({
    "Model": ["Linear Regression", "Polynomial Regression"],
    "MSE": [
        mean_squared_error(y_test, linear_prediction),
        mean_squared_error(y_test, polynomial_prediction)
    ],
    "MAE": [
        mean_absolute_error(y_test, linear_prediction),
        mean_absolute_error(y_test, polynomial_prediction)
    ],
    "R2 Score": [
        r2_score(y_test, linear_prediction),
        r2_score(y_test, polynomial_prediction)
    ]
})

print("\nMODEL COMPARISON")
print(results.round(4))

results.to_csv("regression_results.csv", index=False)

# 7. Actual vs Predicted Graph
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
plt.scatter(y_test, linear_prediction)
plt.xlabel("Actual House Value")
plt.ylabel("Predicted House Value")
plt.title("Linear Regression")

plt.subplot(1, 2, 2)
plt.scatter(y_test, polynomial_prediction)
plt.xlabel("Actual House Value")
plt.ylabel("Predicted House Value")
plt.title("Polynomial Regression")

plt.tight_layout()
plt.show()

# 8. Model Metrics Graph
results.set_index("Model")[["MSE", "MAE"]].plot(kind="bar")
plt.title("Model Performance Comparison")
plt.ylabel("Error")
plt.show()

print("Practical Completed Successfully!")
