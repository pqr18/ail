# Clustering Techniques: K-Means and Hierarchical Clustering
# Dataset: mall dataset

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from scipy.cluster.hierarchy import dendrogram, linkage, fcluster

# 1. Load Dataset
df = pd.read_csv("Mall_Customers.csv")

print("First 5 rows:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

# 2. Select Numerical Columns
data = df.select_dtypes(include=np.number)

# Handle missing values
data = data.fillna(data.median())

# Remove constant columns
data = data.loc[:, data.nunique() > 1]

if data.shape[1] < 2:
    raise ValueError("Dataset must have at least 2 useful numerical columns.")

print("\nSelected Features:")
print(data.head())

# 3. Standardize Data
scaler = StandardScaler()
X = scaler.fit_transform(data)

# 4. Elbow Method for K-Means
inertia = []

for k in range(1, 11):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X)
    inertia.append(kmeans.inertia_)

# Plot Elbow Curve
plt.figure(figsize=(8, 5))
plt.plot(range(1, 11), inertia, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("WCSS / Inertia")
plt.grid()
plt.show()

# 5. Apply K-Means (K = 3)
k = 3

kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
df["KMeans_Cluster"] = kmeans.fit_predict(X)

print("\nK-Means Cluster Counts:")
print(df["KMeans_Cluster"].value_counts())

# 6. Visualize K-Means Clusters
plt.figure(figsize=(8, 5))
plt.scatter(X[:, 0], X[:, 1],
            c=df["KMeans_Cluster"], cmap="viridis")
plt.title("K-Means Clustering")
plt.xlabel(data.columns[0])
plt.ylabel(data.columns[1])
plt.show()

# 7. Hierarchical Clustering
linked = linkage(X, method='ward')

# 8. Draw Dendrogram
plt.figure(figsize=(12, 6))
dendrogram(linked)
plt.title("Hierarchical Clustering Dendrogram")
plt.xlabel("Data Points")
plt.ylabel("Distance")
plt.show()

# 9. Apply Hierarchical Clustering
df["Hierarchical_Cluster"] = fcluster(
    linked, t=k, criterion='maxclust'
)

print("\nHierarchical Cluster Counts:")
print(df["Hierarchical_Cluster"].value_counts())

# 10. Analyze Clusters
print("\nK-Means Cluster Analysis:")
print(df.groupby("KMeans_Cluster")[data.columns.tolist()].mean())

print("\nHierarchical Cluster Analysis:")
print(df.groupby("Hierarchical_Cluster")[data.columns.tolist()].mean())

print("\nProgram Completed Successfully!")
